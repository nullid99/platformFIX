# Copy this file to .env.staging on the Hetzner host. Do not commit .env.staging.
POSTGRES_DB=fix_platform_staging
POSTGRES_USER=fix_app_staging
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://fix_app_staging:replace-with-a-long-random-password@db:5432/fix_platform_staging?schema=public

API_PORT=4000
AUTH_COOKIE_SECURE=false
WEB_ORIGIN=http://167.233.113.236:8082
PUBLIC_WEB_ORIGIN=http://167.233.113.236:8082
# Browser requests use the public same-origin /api proxy. Do not point this at
# the private Docker hostname; it is not resolvable from a user's browser.
NEXT_PUBLIC_API_URL=
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# Generate a separate value for this staging project (at least 32 characters).
AUTH_ENCRYPTION_KEY=replace-with-a-separate-32-character-staging-key
DEV_AUTH_ENABLED=false
NEXT_PUBLIC_DEV_AUTH_ENABLED=false
STAGING_DEV_AUTH_ENABLED=false

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://167.233.113.236:8082/api/auth/discord/callback

FILE_STORAGE_ROOT=.storage/private
MAX_UPLOAD_BYTES=10485760
GEOIP_ENABLED=true
# Replace with an approved provider if required by your deployment/privacy policy.
GEOIP_LOOKUP_URL=https://ipwho.is/{ip}
RESEND_API_KEY=
EMAIL_FROM=FIX Platform <onboarding@resend.dev>
EMAIL_LOGO_URL=
EMAIL_BACKGROUND_URL=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Leave blank until after first deploy — set by running
# `npm run api:bootstrap-stream-webhook` once PUBLIC_WEB_ORIGIN above is live and public.
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
