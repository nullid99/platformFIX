DATABASE_URL="postgresql://fix_app:fix_dev_password@localhost:5432/fix_platform?schema=public"
API_PORT="4000"
WEB_ORIGIN="http://localhost:3000"
TRUST_PROXY="false"
TRUST_PROXY_HOPS="0"
AUTH_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:4000/api/auth/discord/callback"
NEXT_PUBLIC_API_URL="http://localhost:4000"
DEV_AUTH_ENABLED="false"
NEXT_PUBLIC_DEV_AUTH_ENABLED="false"
FILE_STORAGE_ROOT=".storage/private"
MAX_UPLOAD_BYTES="10485760"
GEOIP_ENABLED="true"
# Optional provider URL template. The default uses ipwho.is; replace with your approved GeoIP provider in production.
GEOIP_LOOKUP_URL="https://ipwho.is/{ip}"
RESEND_API_KEY=""
# Self-hosted LiveKit server for live streaming (see /opt/livekit on the LiveKit box for its docker-compose config).
LIVEKIT_HOST="https://livekit.fix-trading.info"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_ROOM_NAME="practicum-live"
NEXT_PUBLIC_LIVEKIT_URL="wss://livekit.fix-trading.info"
# LiveKit Egress recording storage — MinIO running alongside LiveKit on the same box.
# LIVEKIT_RECORDING_S3_ENDPOINT is the egress process's own loopback address to MinIO (never
# reachable from a browser); LIVEKIT_RECORDING_S3_PUBLIC_URL is the Caddy-fronted HTTPS domain
# a viewer's browser uses to fetch a presigned playback URL.
LIVEKIT_RECORDING_S3_ENDPOINT="http://127.0.0.1:9000"
LIVEKIT_RECORDING_S3_PUBLIC_URL="https://recordings.fix-trading.info"
LIVEKIT_RECORDING_S3_BUCKET="recordings"
LIVEKIT_RECORDING_S3_ACCESS_KEY=""
LIVEKIT_RECORDING_S3_SECRET_KEY=""
EMAIL_FROM="FIX Platform <onboarding@resend.dev>"
PUBLIC_WEB_ORIGIN="http://localhost:3000"
EMAIL_LOGO_URL=""
EMAIL_BACKGROUND_URL=""
