generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  CURATOR
  OWNER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DELETED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SessionStatus {
  ACTIVE
  PENDING
  REVOKED
  EXPIRED
}

enum IdentityProvider {
  DISCORD
  LOCAL
}

enum LoginEventOutcome {
  SUCCESS
  FAILED
  CHALLENGE
  BLOCKED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  REVOKED
  COMPLETED
}

// Independent of MediaAssetKind (that's WHAT the recording is; this is WHO can see it) — a
// curator can mark any recording, attached to a module or not, as Advanced-only. Kept as its
// own dimension rather than folded into kind so a video stays taggable by both at once (e.g.
// still a QA recording, just restricted) instead of losing its kind to express audience.
enum MediaAudience {
  ALL
  ADVANCED
}

enum MediaAssetKind {
  LESSON_VIDEO
  STREAM
  QA
  BREAKDOWN
  TALKS
}

enum MediaAssetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ScheduleEventType {
  PRACTICE
  QA
  BREAKDOWN
  BACKTEST
  LECTURE
  PRE_SESSION
}

enum ScheduleBookingAction {
  BOOKED
  CANCELLED
}

enum ModuleAccessStatus {
  LOCKED
  UNLOCKED
  COMPLETED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  NEEDS_REVISION
  ACCEPTED
}

enum StoredFileStatus {
  PENDING
  UPLOADED
  FAILED
  DELETED
}

enum AssignmentMaterialKind {
  LINK
  FILE
}

enum DiscussionStatus {
  NEW
  WAITING
  ANSWERED
  CLOSED
}

enum DiscussionVisibility {
  PRIVATE
  COHORT
}

enum NotificationType {
  NEW_ASSIGNMENT
  NEW_SUBMISSION
  NEW_MEDIA
  NEW_EVENT
  NEW_MODULE
  MODULE_OPENED
  DISCUSSION_REPLY
  REVIEW_DECISION
  STREAM_LIVE
  SCHEDULE_REMINDER
  SECURITY_ALERT
  CURATOR_REMINDER
}

model User {
  id                        String                   @id @default(cuid())
  email                     String?                  @unique
  passwordHash              String?
  // Curator-granted, per-person (not per-enrollment) — a student's Advanced tier follows them
  // across cohorts rather than resetting on re-enrollment. Meaningless for CURATOR/OWNER rows.
  // Gates the "Advanced" Module.section track and MediaAudience.ADVANCED recordings — see
  // course-service.ts#getForUser.
  isAdvanced                Boolean                  @default(false)
  role                      UserRole
  // Reserved for the platform's actual owner, set once that person is finally promoted (see
  // auth-service.ts#revokeOwnerRole) — nobody has this yet. An owner with this flag can't have
  // OWNER revoked by anyone through the app, including by another owner; everything else about
  // two owners' powers stays identical. Meaningless for STUDENT/CURATOR rows.
  isProtectedOwner          Boolean                  @default(false)
  status                    UserStatus               @default(INVITED)
  emailVerifiedAt           DateTime?
  twoFactorEnabled          Boolean                  @default(false)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  externalIdentities        ExternalIdentity[]
  sessions                  Session[]
  sentInvitations           Invitation[]             @relation("InvitationSender")
  acceptedInvitations       Invitation[]             @relation("InvitationAcceptedBy")
  enrollments               Enrollment[]
  submissions               Submission[]
  reviewClaims              Submission[]             @relation("SubmissionReviewer")
  storedFiles               StoredFile[]
  feedback                  Feedback[]               @relation("FeedbackAuthor")
  studentDiscussionThreads  DiscussionThread[]       @relation("DiscussionStudentThreads")
  curatorDiscussionThreads  DiscussionThread[]       @relation("DiscussionCuratorThreads")
  discussionMessages        DiscussionMessage[]
  auditLogs                 AuditLog[]
  loginEvents               LoginEvent[]
  emailVerificationTokens   EmailVerificationToken[]
  streamMessages            StreamMessage[]
  streamMessageReactions    StreamMessageReaction[]
  mediaPlaybackEvents       MediaPlaybackEvent[]
  notifications             Notification[]
  backtestBookings          ScheduleEvent[]          @relation("ScheduleEventBooking")
  scheduleBookingsAsStudent ScheduleBooking[]        @relation("ScheduleBookingStudent")
  scheduleBookingsAsActor   ScheduleBooking[]        @relation("ScheduleBookingActor")
  // Per-curator email preference — the in-app bell always fires regardless (see
  // notification-service.ts), this only gates whether that event also sends an email to this
  // specific curator/owner. Meaningless for STUDENT rows.
  notifyNewSubmission       Boolean                  @default(true)
  notifyNewQuestion         Boolean                  @default(true)
  // A curator/owner's personal "which practicum am I creating content in right now" pointer —
  // independent from Practicum.isActive (which only targets live streaming, unchanged). Null
  // means "no personal pick yet", so every resolver falls back to the active practicum — see
  // practicum-service.ts#getWorkingPracticumId. Two staff members can point at different
  // practicums at the same time without affecting each other or the live-stream target.
  workingPracticumId        String?
  /// IANA zone the student picked in "Профиль" ("Europe/Berlin"); null = take it from the browser.
  /// Schedule times are stored as Kyiv wall-clock (schedule-time.ts) and only converted for display.
  timeZone                  String?
  workingPracticum          Practicum?               @relation("UserWorkingPracticum", fields: [workingPracticumId], references: [id], onDelete: SetNull)
  startedStreamsFor         Practicum[]              @relation("PracticumStreamStartedBy")

  @@index([role, status])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, usedAt])
}

model ExternalIdentity {
  id              String           @id @default(cuid())
  userId          String
  provider        IdentityProvider
  providerSubject String
  username        String?
  displayName     String?
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model Invitation {
  id             String            @id @default(cuid())
  email          String?
  role           UserRole
  tokenHash      String            @unique
  status         InvitationStatus  @default(PENDING)
  targetProvider IdentityProvider?
  targetSubject  String?
  practicumId    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime          @default(now())
  createdById    String?
  acceptedById   String?
  createdBy      User?             @relation("InvitationSender", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedBy     User?             @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  practicum      Practicum?        @relation(fields: [practicumId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([targetProvider, targetSubject, status])
  @@index([practicumId, status])
  @@index([expiresAt, status])
}

model Session {
  id            String        @id @default(cuid())
  userId        String
  tokenHash     String        @unique
  deviceKeyHash String?
  status        SessionStatus @default(ACTIVE)
  deviceName    String?
  userAgent     String?
  ipAddress     String?
  ipHash        String?
  countryCode   String?
  city          String?
  riskScore     Int?
  riskReason    String?
  lastActiveAt  DateTime      @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, lastActiveAt])
  @@index([deviceKeyHash, status])
  @@index([ipAddress, createdAt])
  @@index([expiresAt, status])
}

model LoginEvent {
  id              String            @id @default(cuid())
  userId          String?
  provider        IdentityProvider?
  providerSubject String?
  outcome         LoginEventOutcome
  deviceName      String?
  userAgent       String?
  ipAddress       String?
  ipHash          String?
  countryCode     String?
  city            String?
  riskScore       Int?
  reasonCode      String?
  createdAt       DateTime          @default(now())
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([outcome, createdAt])
  @@index([ipHash, createdAt])
}

model DiscordAuthChallenge {
  id                        String    @id @default(cuid())
  stateHash                 String    @unique
  codeVerifierCiphertext    String
  invitationTokenCiphertext String?
  redirectUri               String
  expiresAt                 DateTime
  usedAt                    DateTime?
  createdAt                 DateTime  @default(now())

  @@index([expiresAt, usedAt])
}

model Practicum {
  id                            String            @id @default(cuid())
  title                         String
  description                   String?
  accessUntil                   DateTime?
  // Curator/owner-set, reversible — "Завершить поток" on the Потоки screen. Deliberately NOT a
  // hard access cutoff like accessUntil above (which nothing currently reads): a completed
  // practicum's students keep full read access (modules, ДЗ history, recordings, Practice/
  // Advanced) — only the write actions (submit/resubmit ДЗ, ask/reply in discussions) check this
  // and refuse once it's set. See practicum-service.ts#isPracticumCompleted.
  completedAt                   DateTime?
  // The practicum live streaming targets (LiveKit ingress, "Стримы") and the fallback every
  // resolver uses when a curator/owner has no personal workingPracticumId set yet — see
  // app/server/course/practicum-service.ts#getActivePracticumId. Content creation itself (module,
  // schedule event, standalone media, invitation default) instead follows each staff member's own
  // User.workingPracticumId — see #getWorkingPracticumId — so two people can work in different
  // practicums at once without touching which one is "active". A finished cohort's own
  // enrollments/modules/media keep pointing at its (now inactive) row forever, so its students
  // keep seeing exactly what they always saw.
  isActive                      Boolean           @default(false)
  liveKitIngressId              String?
  isCurrentlyLive               Boolean           @default(false)
  currentStreamSessionStartedAt DateTime?
  // Per-cohort "private stream" switch (a personal 1:1 session, or recording something to
  // publish later) — see practicum-admin-service.ts#setPracticumStreamsPrivate and
  // stream-visibility.ts. Deliberately per-practicum rather than global: flipping it on for
  // this cohort must not carry over to whichever practicum becomes active next.
  streamsPrivate                Boolean           @default(false)
  backtestSlotLimit             Int               @default(1)
  preSessionSlotLimit           Int               @default(1)
  // What the curator picked as the target for the NEXT/current broadcast on the "Стримы"
  // page — consumed (and cleared) by StreamService.createMediaAssetFromRecording once the
  // LiveKit egress completes, so it auto-attaches + auto-publishes there instead of landing as an
  // unassigned draft. Mutually exclusive by convention, same as MediaAsset.moduleId/scheduleEventId.
  pendingStreamModuleId         String?
  pendingStreamScheduleEventId  String?
  // Only meaningful alongside pendingStreamModuleId — a module's stream recordings split into
  // the "Тематические записи" (STREAM) and "Q&A с куратором" (QA) blocks, so the curator picks
  // which one this broadcast is for. Null/unset defaults to STREAM in createMediaAssetFromRecording.
  pendingStreamMediaKind        MediaAssetKind?
  // Who pressed "Начать стрим" (or picked the target on "Стримы") for the current/next broadcast
  // and when — shown to every curator as "Эфир ведёт: Имя", since all curators share one OBS key
  // and LiveKit itself can't tell who is behind it. Cleared by "Завершить эфир".
  streamStartedById             String?
  streamStartedAt               DateTime?
  streamStartedBy               User?             @relation("PracticumStreamStartedBy", fields: [streamStartedById], references: [id], onDelete: SetNull)
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt
  enrollments                   Enrollment[]
  modules                       Module[]
  invitations                   Invitation[]
  mediaAssets                   MediaAsset[]
  scheduleEvents                ScheduleEvent[]
  streamMessages                StreamMessage[]
  scheduleBookings              ScheduleBooking[]
  workingForUsers               User[]            @relation("UserWorkingPracticum")
  assignments                   Assignment[]
}

model StreamMessage {
  id          String                  @id @default(cuid())
  practicumId String
  authorId    String
  body        String
  fileId      String?
  replyToId   String?
  /**
   * { title, imageUrl, siteName, sourceUrl } — populated at send time for a recognized TradingView chart-snapshot link in the body.
   */
  linkPreview Json?
  createdAt   DateTime                @default(now())
  practicum   Practicum               @relation(fields: [practicumId], references: [id], onDelete: Cascade)
  author      User                    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  file        StoredFile?             @relation(fields: [fileId], references: [id], onDelete: SetNull)
  // SetNull (not Cascade) — deleting the original leaves replies in place, just without a
  // quoted preview, same as Discord "Original message was deleted".
  replyTo     StreamMessage?          @relation("StreamMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     StreamMessage[]         @relation("StreamMessageReplies")
  reactions   StreamMessageReaction[]

  @@index([practicumId, createdAt])
  @@index([fileId])
  @@index([replyToId])
}

model StreamMessageReaction {
  id        String        @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime      @default(now())
  message   StreamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Enrollment {
  id             String                   @id @default(cuid())
  studentId      String
  practicumId    String
  status         EnrollmentStatus         @default(ACTIVE)
  accessUntil    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  student        User                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  practicum      Practicum                @relation(fields: [practicumId], references: [id], onDelete: Cascade)
  moduleAccesses EnrollmentModuleAccess[]

  @@unique([studentId, practicumId])
  @@index([practicumId, status])
}

model Module {
  id                String                   @id @default(cuid())
  practicumId       String
  title             String
  description       String?
  section           String                   @default("Education")
  coverPath         String?
  position          Int
  // Source of truth for "is this module open to the whole cohort" — set by the curator's
  // module-wide toggle. A student's own EnrollmentModuleAccess row still decides what THEY
  // see; this only decides what a newly-enrolling student inherits and what the curator's
  // admin screen reports (previously that screen just guessed from one arbitrary student's
  // row, which is what caused open-looking-but-actually-locked modules).
  defaultAccess     ModuleAccessStatus       @default(LOCKED)
  // Curator-written Q&A discussion prompts for this lesson — a plain string array, shown above
  // "Открыть обсуждение" (see ModuleOverviewPage). Previously this was the same hardcoded demo
  // text for every lesson (modulePageContentFor's baseContent.questions); this is the real,
  // per-lesson replacement.
  qaQuestions       Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  practicum         Practicum                @relation(fields: [practicumId], references: [id], onDelete: Cascade)
  mediaAssets       MediaAsset[]
  mediaGroups       MediaGroup[]
  assignments       Assignment[]
  accessRecords     EnrollmentModuleAccess[]
  discussionThreads DiscussionThread[]

  @@unique([practicumId, position])
  @@index([practicumId])
}

/**
 * Curator-defined named section inside one lesson — "Бектест", "Пресессия", or whatever else a
 * curator comes up with — each holding its own set of MediaAsset recordings. Built for Практика
 * lessons (whose template drops the fixed "Тематические записи"/ДЗ/Q&A blocks in favour of
 * however many of these the curator wants), but not restricted to that section — nothing here
 * assumes Module.section === "Practice".
 */
model MediaGroup {
  id          String       @id @default(cuid())
  moduleId    String
  title       String
  position    Int
  createdAt   DateTime     @default(now())
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  mediaAssets MediaAsset[]

  @@unique([moduleId, position])
  @@index([moduleId])
}

model EnrollmentModuleAccess {
  id           String             @id @default(cuid())
  enrollmentId String
  moduleId     String
  status       ModuleAccessStatus @default(LOCKED)
  progress     Int                @default(0)
  // True only when a curator explicitly set access for this one student (open or close),
  // as opposed to inheriting the module's defaultAccess. The module-wide toggle skips
  // override rows so it never silently clobbers a curator's individual decision.
  isOverride   Boolean            @default(false)
  unlockedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  enrollment   Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  module       Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, moduleId])
  @@index([moduleId, status])
}

model MediaAsset {
  id                   String               @id @default(cuid())
  practicumId          String
  moduleId             String?
  scheduleEventId      String?
  // Which curator-named MediaGroup ("Бектест", "Пресессия"...) this belongs to inside its
  // module — null for anything not sorted into one yet (including every Теория lesson, which
  // doesn't use groups at all).
  groupId              String?
  provider             String
  providerKey          String
  kind                 MediaAssetKind       @default(STREAM)
  // Set by the curator at publish time, independent of moduleId/kind — ADVANCED hides this
  // recording from every student except User.isAdvanced ones, whether it's attached to a
  // Theory/Practice lesson or sitting unattached in the general "Записи" library.
  audience             MediaAudience        @default(ALL)
  status               MediaAssetStatus     @default(DRAFT)
  title                String?
  description          String?
  mimeType             String?
  durationSec          Int?
  // Int overflows past 2GB, which a single-segment 1440p recording clears well within an hour —
  // see stream-service.ts#finishRecording, which reads this straight off the LiveKit webhook's
  // own FileInfo instead of asking S3/MinIO for it separately.
  byteSize             BigInt?
  position             Int                  @default(0)
  // Curator's manual order for the practicum-wide "Медиатека" overview (CuratorMediaLibraryView),
  // which mixes items from three different scopes (module-attached, schedule-event-attached, and
  // unattached/global) that each already use `position` for their OWN, unrelated ordering
  // (per-module lesson order, etc). Kept as a separate field so dragging one list never disturbs
  // the other. Untouched assets share the default 0 and fall back to newest-first ordering.
  libraryPosition      Int                  @default(0)
  publishedAt          DateTime?
  // Snapshot of the live-chat time window at the moment this asset was auto-created from a
  // stream recording — lets StreamChatService.getArchivedMessages find "the chat that
  // happened during this broadcast" without needing a session id on StreamMessage itself.
  // Null for anything not auto-created from a live recording (manual Vimeo uploads etc).
  chatSessionStartedAt DateTime?
  chatSessionEndedAt   DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  practicum            Practicum            @relation(fields: [practicumId], references: [id], onDelete: Cascade)
  module               Module?              @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  scheduleEvent        ScheduleEvent?       @relation(fields: [scheduleEventId], references: [id], onDelete: SetNull)
  group                MediaGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  feedback             Feedback[]
  playbackEvents       MediaPlaybackEvent[]

  @@unique([provider, providerKey, moduleId])
  @@index([moduleId, status, position])
  @@index([scheduleEventId, status, position])
  @@index([groupId, status, position])
  @@index([practicumId, status, position])
}

/**
 * One row per time a viewer actually opens a video (not per API fetch) — the
 * audit trail behind the on-screen watermark. If a recording leaks, cross-referencing
 * who opened that exact media around the leaked timestamp narrows down the source.
 */
/**
 * Backs the in-app notification bell — real per-user events, not the static demo list it replaced.
 */
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  entityId  String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

/**
 * A single global row (id is always "singleton") — not tied to any Practicum, deliberately, so
 * flipping it off doesn't get reset by starting a new cohort. Exists for exactly one workflow:
 * a curator migrating recordings off the LiveKit box between cohorts triggers a burst of
 * content-change events that would otherwise spam students/curators with irrelevant
 * notifications. Gated centrally (NotificationService.create/createMany, email-service's
 * sendMutableEmail) rather than at each of the many call sites that fire a notification, so a
 * future notification type respects this automatically. Security alerts and account emails
 * (invitations, email verification) intentionally bypass it — see notification-settings.ts.
 */
model PlatformSettings {
  id                   String   @id @default("singleton")
  notificationsEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model MediaPlaybackEvent {
  id           String     @id @default(cuid())
  mediaAssetId String
  userId       String
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime   @default(now())
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mediaAssetId, createdAt])
  @@index([userId, createdAt])
}

model ScheduleEvent {
  id                String            @id @default(cuid())
  practicumId       String
  type              ScheduleEventType
  title             String
  date              DateTime          @db.Date
  time              String
  description       String
  live              Boolean           @default(false)
  coverPath         String?
  /// Set by "Завершить эфир" (StreamService#finishStream) — students' schedule then shows the
  /// event as "Эфир завершён" (+ "Открыть запись" once the curator publishes the recording
  /// draft). Cleared again if the curator restarts a stream from the same event.
  streamEndedAt     DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  practicum         Practicum         @relation(fields: [practicumId], references: [id], onDelete: Cascade)
  mediaAssets       MediaAsset[]
  // Individual BACKTEST/PRE_SESSION slots: one event = one bookable time, claimed by at
  // most one student. ScheduleService.book() enforces a per-student, per-type limit read
  // from Practicum.backtestSlotLimit/preSessionSlotLimit (default 1) — a count against the
  // configured limit, not a hardcoded one-time check.
  bookedByStudentId String?
  bookedAt          DateTime?
  bookedBy          User?             @relation("ScheduleEventBooking", fields: [bookedByStudentId], references: [id], onDelete: SetNull)

  @@index([practicumId, date])
  @@index([practicumId, type, date])
  @@index([bookedByStudentId])
}

/**
 * Curator-managed, platform-wide reusable cover images for the schedule-event creation form's
 * picker grid (see ScheduleEventForm) — deliberately not scoped to a practicum. `coverPath` is a
 * plain string like `Module.coverPath`/`ScheduleEvent.coverPath` (either a static `/event-covers/…`
 * asset for the built-in seeded set, or `/api/files/:id/content` for a curator-uploaded one) —
 * no FK to StoredFile, so deleting a template never touches events that already copied its path.
 */
model ScheduleCoverTemplate {
  id        String   @id @default(cuid())
  label     String
  coverPath String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([position])
}

/**
 * Append-only log of book/cancel actions — ScheduleEvent.bookedByStudentId only holds the
 * CURRENT booking (nulled out on cancel), so this is the only place booking history lives.
 * Stores a snapshot of the event's title/date/time so history stays readable even if the
 * original event is later edited or deleted; eventId is a plain reference, not an FK.
 */
model ScheduleBooking {
  id          String                @id @default(cuid())
  practicumId String
  eventId     String
  eventType   ScheduleEventType
  eventTitle  String
  eventDate   DateTime              @db.Date
  eventTime   String
  studentId   String
  action      ScheduleBookingAction
  actorId     String
  createdAt   DateTime              @default(now())
  practicum   Practicum             @relation(fields: [practicumId], references: [id], onDelete: Cascade)
  student     User                  @relation("ScheduleBookingStudent", fields: [studentId], references: [id], onDelete: Cascade)
  actor       User                  @relation("ScheduleBookingActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([practicumId, eventType, createdAt])
}

model Assignment {
  id                String               @id @default(cuid())
  // Nullable only for isPractice — a normal assignment is always inside a lesson. Practice
  // assignments aren't attached to any lesson (that's the whole point — no deadline, no
  // requirements, no module-completion gate), so this stays null for those and practicumId
  // below carries the targeting instead.
  moduleId          String?
  // Always set. For a regular assignment this mirrors module.practicumId (kept as its own
  // column rather than derived, so discussion-service.ts and the practice listing don't need to
  // traverse a possibly-null module relation just to find out which cohort to check).
  practicumId       String
  // Практическое задание — see course this session's per-track Практика work. No deadline, no
  // requirements checklist, not gated behind a module. Interaction happens as a DiscussionThread
  // (assignmentId-linked) instead of the formal Submission/decide() review flow — a curator just
  // replies in plain text, no accept/needs-revision buttons.
  isPractice        Boolean              @default(false)
  // "ДЗ без проверки" — the student's own "Выполнено" click creates an already-ACCEPTED
  // Submission directly (see AssignmentService#completeWithoutReview), skipping the curator
  // review queue entirely. Exists for lessons with no real homework, where the normal
  // "every assignment ACCEPTED → unlock next module" gate would otherwise never fire because
  // nothing was ever there for a curator to accept.
  reviewRequired    Boolean              @default(true)
  title             String
  description       String
  requirements      Json?
  allowedFormats    Json?
  status            AssignmentStatus     @default(DRAFT)
  deadline          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  module            Module?              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  practicum         Practicum            @relation(fields: [practicumId], references: [id], onDelete: Cascade)
  submissions       Submission[]
  materials         AssignmentMaterial[]
  discussionThreads DiscussionThread[]

  @@index([moduleId, status])
  @@index([practicumId, isPractice, status])
}

model Submission {
  id                  String                 @id @default(cuid())
  assignmentId        String
  studentId           String
  attempt             Int                    @default(1)
  status              SubmissionStatus       @default(DRAFT)
  answerText          String?
  attachments         Json?
  submittedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  reviewerId          String?
  claimedAt           DateTime?
  // Snapshot (requirement text, not index — the assignment's own list can change later) of
  // which criteria the curator had checked off at the moment they decided. Criteria are
  // advisory, not a hard gate for acceptance — this is what lets the student/curator see
  // later that a submission was accepted even though not every box was ticked.
  checkedRequirements Json?
  assignment          Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student             User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer            User?                  @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  fileAttachments     SubmissionAttachment[]
  feedback            Feedback[]

  @@unique([assignmentId, studentId, attempt])
  @@index([studentId, status])
  @@index([assignmentId, status])
  @@index([reviewerId, status])
}

model StoredFile {
  id                    String                 @id @default(cuid())
  ownerId               String
  storageKey            String                 @unique
  originalName          String
  mimeType              String
  byteSize              Int
  status                StoredFileStatus       @default(PENDING)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  owner                 User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  submissions           SubmissionAttachment[]
  assignmentMaterials   AssignmentMaterial[]
  discussionAttachments DiscussionAttachment[]
  feedbackAttachments   FeedbackAttachment[]
  streamMessages        StreamMessage[]

  @@index([ownerId, status])
}

model AssignmentMaterial {
  id           String                 @id @default(cuid())
  assignmentId String
  kind         AssignmentMaterialKind
  title        String
  url          String?
  fileId       String?
  mimeType     String?
  byteSize     Int?
  position     Int                    @default(0)
  createdAt    DateTime               @default(now())
  assignment   Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  file         StoredFile?            @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([assignmentId, position])
  @@index([fileId])
}

model SubmissionAttachment {
  id           String     @id @default(cuid())
  submissionId String
  fileId       String
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  file         StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([submissionId, fileId])
  @@index([submissionId, position])
}

model Feedback {
  id           String               @id @default(cuid())
  submissionId String
  authorId     String
  text         String
  mediaAssetId String?
  createdAt    DateTime             @default(now())
  submission   Submission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author       User                 @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  mediaAsset   MediaAsset?          @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  attachments  FeedbackAttachment[]

  @@index([submissionId, createdAt])
}

model FeedbackAttachment {
  id           String     @id @default(cuid())
  feedbackId   String
  fileId       String
  originalName String
  mimeType     String
  byteSize     Int
  createdAt    DateTime   @default(now())
  feedback     Feedback   @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  file         StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([feedbackId, createdAt])
  @@index([fileId])
}

model DiscussionThread {
  id            String               @id @default(cuid())
  studentId     String
  curatorId     String?
  moduleId      String?
  assignmentId  String?
  title         String
  status        DiscussionStatus     @default(NEW)
  visibility    DiscussionVisibility @default(PRIVATE)
  lastMessageAt DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  student       User                 @relation("DiscussionStudentThreads", fields: [studentId], references: [id], onDelete: Cascade)
  curator       User?                @relation("DiscussionCuratorThreads", fields: [curatorId], references: [id], onDelete: SetNull)
  module        Module?              @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  assignment    Assignment?          @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  messages      DiscussionMessage[]

  @@index([studentId, lastMessageAt])
  @@index([curatorId, status, lastMessageAt])
  @@index([assignmentId, createdAt])
}

model DiscussionMessage {
  id          String                 @id @default(cuid())
  threadId    String
  authorId    String
  body        String
  createdAt   DateTime               @default(now())
  thread      DiscussionThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author      User                   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  attachments DiscussionAttachment[]

  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
}

model DiscussionAttachment {
  id           String            @id @default(cuid())
  messageId    String
  fileId       String?
  sourceUrl    String?
  originalName String
  mimeType     String
  byteSize     Int
  createdAt    DateTime          @default(now())
  message      DiscussionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file         StoredFile?       @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([messageId, createdAt])
  @@index([fileId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  objectType String?
  objectId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([objectType, objectId])
}
