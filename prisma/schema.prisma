generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  CURATOR
  OWNER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DELETED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SessionStatus {
  ACTIVE
  PENDING
  REVOKED
  EXPIRED
}

enum IdentityProvider {
  DISCORD
  LOCAL
}

enum LoginEventOutcome {
  SUCCESS
  FAILED
  CHALLENGE
  BLOCKED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  REVOKED
  COMPLETED
}

enum MediaAssetKind {
  LESSON_VIDEO
  STREAM
  QA
  BREAKDOWN
  TALKS
}

enum MediaAssetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ScheduleEventType {
  PRACTICE
  QA
  BREAKDOWN
  BACKTEST
  LECTURE
  PRE_SESSION
}

enum ScheduleBookingAction {
  BOOKED
  CANCELLED
}

enum ModuleAccessStatus {
  LOCKED
  UNLOCKED
  COMPLETED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  NEEDS_REVISION
  ACCEPTED
}

enum StoredFileStatus {
  PENDING
  UPLOADED
  FAILED
  DELETED
}

enum AssignmentMaterialKind {
  LINK
  FILE
}

enum DiscussionStatus {
  NEW
  WAITING
  ANSWERED
  CLOSED
}

enum DiscussionVisibility {
  PRIVATE
  COHORT
}

enum NotificationType {
  NEW_ASSIGNMENT
  NEW_MEDIA
  NEW_EVENT
  DISCUSSION_REPLY
  REVIEW_DECISION
  STREAM_LIVE
  SCHEDULE_REMINDER
  SECURITY_ALERT
}

model User {
  id                 String               @id @default(cuid())
  email              String?              @unique
  passwordHash       String?
  role               UserRole
  status             UserStatus           @default(INVITED)
  emailVerifiedAt    DateTime?
  twoFactorEnabled   Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  externalIdentities ExternalIdentity[]
  sessions           Session[]
  sentInvitations    Invitation[]         @relation("InvitationSender")
  acceptedInvitations Invitation[]        @relation("InvitationAcceptedBy")
  enrollments        Enrollment[]
  curatorAssignments CuratorAssignment[]  @relation("CuratorAssignments")
  studentAssignments CuratorAssignment[]  @relation("StudentAssignments")
  submissions        Submission[]
  reviewClaims       Submission[]        @relation("SubmissionReviewer")
  storedFiles         StoredFile[]
  feedback           Feedback[]           @relation("FeedbackAuthor")
  studentDiscussionThreads DiscussionThread[] @relation("DiscussionStudentThreads")
  curatorDiscussionThreads DiscussionThread[] @relation("DiscussionCuratorThreads")
  discussionMessages DiscussionMessage[]
  auditLogs          AuditLog[]
  loginEvents        LoginEvent[]
  emailVerificationTokens EmailVerificationToken[]
  streamMessages     StreamMessage[]
  streamMessageReactions StreamMessageReaction[]
  mediaPlaybackEvents MediaPlaybackEvent[]
  notifications      Notification[]
  backtestBookings   ScheduleEvent[]      @relation("ScheduleEventBooking")
  scheduleBookingsAsStudent ScheduleBooking[] @relation("ScheduleBookingStudent")
  scheduleBookingsAsActor   ScheduleBooking[] @relation("ScheduleBookingActor")

  @@index([role, status])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, usedAt])
}

model ExternalIdentity {
  id             String           @id @default(cuid())
  userId         String
  provider       IdentityProvider
  providerSubject String
  username       String?
  displayName    String?
  avatarUrl      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model Invitation {
  id             String           @id @default(cuid())
  email          String?
  role           UserRole
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  targetProvider IdentityProvider?
  targetSubject  String?
  practicumId    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  createdById    String?
  acceptedById   String?
  createdBy      User?            @relation("InvitationSender", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedBy     User?            @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  practicum      Practicum?       @relation(fields: [practicumId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([targetProvider, targetSubject, status])
  @@index([practicumId, status])
  @@index([expiresAt, status])
}

model Session {
  id             String        @id @default(cuid())
  userId         String
  tokenHash      String        @unique
  deviceKeyHash  String?
  status         SessionStatus @default(ACTIVE)
  deviceName     String?
  userAgent      String?
  ipAddress      String?
  ipHash         String?
  countryCode    String?
  city           String?
  riskScore      Int?
  riskReason     String?
  lastActiveAt   DateTime      @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, lastActiveAt])
  @@index([deviceKeyHash, status])
  @@index([ipAddress, createdAt])
  @@index([expiresAt, status])
}

model LoginEvent {
  id              String           @id @default(cuid())
  userId          String?
  provider        IdentityProvider?
  providerSubject String?
  outcome         LoginEventOutcome
  deviceName      String?
  userAgent       String?
  ipAddress       String?
  ipHash          String?
  countryCode     String?
  city            String?
  riskScore       Int?
  reasonCode      String?
  createdAt       DateTime         @default(now())
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([outcome, createdAt])
  @@index([ipHash, createdAt])
}

model DiscordAuthChallenge {
  id                       String   @id @default(cuid())
  stateHash                String   @unique
  codeVerifierCiphertext   String
  invitationTokenCiphertext String?
  redirectUri              String
  expiresAt                DateTime
  usedAt                   DateTime?
  createdAt                DateTime @default(now())

  @@index([expiresAt, usedAt])
}

model Practicum {
  id           String       @id @default(cuid())
  title        String
  description  String?
  accessUntil  DateTime?
  // The one practicum new curator-side content (modules, streams, schedule events, invitations)
  // targets by default — see app/server/course/practicum-service.ts#getActivePracticumId. A
  // finished cohort's own enrollments/modules/media keep pointing at its (now inactive) row
  // forever, so its students keep seeing exactly what they always saw.
  isActive     Boolean      @default(false)
  liveKitIngressId String?
  isCurrentlyLive Boolean @default(false)
  currentStreamSessionStartedAt DateTime?
  backtestSlotLimit   Int @default(1)
  preSessionSlotLimit Int @default(1)
  // What the curator picked as the target for the NEXT/current broadcast on the "Стримы"
  // page — consumed (and cleared) by StreamService.createMediaAssetFromRecording once the
  // LiveKit egress completes, so it auto-attaches + auto-publishes there instead of landing as an
  // unassigned draft. Mutually exclusive by convention, same as MediaAsset.moduleId/scheduleEventId.
  pendingStreamModuleId        String?
  pendingStreamScheduleEventId String?
  // Only meaningful alongside pendingStreamModuleId — a module's stream recordings split into
  // the "Тематические записи" (STREAM) and "Q&A с куратором" (QA) blocks, so the curator picks
  // which one this broadcast is for. Null/unset defaults to STREAM in createMediaAssetFromRecording.
  pendingStreamMediaKind       MediaAssetKind?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  enrollments  Enrollment[]
  modules      Module[]
  invitations  Invitation[]
  mediaAssets  MediaAsset[]
  scheduleEvents ScheduleEvent[]
  streamMessages StreamMessage[]
  scheduleBookings ScheduleBooking[]
}

model StreamMessage {
  id          String     @id @default(cuid())
  practicumId String
  authorId    String
  body        String
  fileId      String?
  replyToId   String?
  /** { title, imageUrl, siteName, sourceUrl } — populated at send time for a recognized TradingView chart-snapshot link in the body. */
  linkPreview Json?
  createdAt   DateTime   @default(now())
  practicum   Practicum  @relation(fields: [practicumId], references: [id], onDelete: Cascade)
  author      User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  file        StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  // SetNull (not Cascade) — deleting the original leaves replies in place, just without a
  // quoted preview, same as Discord "Original message was deleted".
  replyTo     StreamMessage? @relation("StreamMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     StreamMessage[] @relation("StreamMessageReplies")
  reactions   StreamMessageReaction[]

  @@index([practicumId, createdAt])
  @@index([fileId])
  @@index([replyToId])
}

model StreamMessageReaction {
  id        String        @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime      @default(now())
  message   StreamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Enrollment {
  id          String           @id @default(cuid())
  studentId   String
  practicumId String
  status      EnrollmentStatus @default(ACTIVE)
  accessUntil DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  practicum   Practicum        @relation(fields: [practicumId], references: [id], onDelete: Cascade)
  moduleAccesses EnrollmentModuleAccess[]

  @@unique([studentId, practicumId])
  @@index([practicumId, status])
}

model CuratorAssignment {
  id        String   @id @default(cuid())
  curatorId String
  studentId String
  createdAt DateTime @default(now())
  curator   User     @relation("CuratorAssignments", fields: [curatorId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([curatorId, studentId])
  @@index([studentId])
}

model Module {
  id          String     @id @default(cuid())
  practicumId String
  title       String
  description String?
  section     String     @default("Education")
  coverPath   String?
  position    Int
  // Source of truth for "is this module open to the whole cohort" — set by the curator's
  // module-wide toggle. A student's own EnrollmentModuleAccess row still decides what THEY
  // see; this only decides what a newly-enrolling student inherits and what the curator's
  // admin screen reports (previously that screen just guessed from one arbitrary student's
  // row, which is what caused open-looking-but-actually-locked modules).
  defaultAccess ModuleAccessStatus @default(LOCKED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  practicum   Practicum  @relation(fields: [practicumId], references: [id], onDelete: Cascade)
  mediaAssets MediaAsset[]
  assignments Assignment[]
  accessRecords EnrollmentModuleAccess[]
  discussionThreads DiscussionThread[]

  @@unique([practicumId, position])
  @@index([practicumId])
}

model EnrollmentModuleAccess {
  id           String             @id @default(cuid())
  enrollmentId String
  moduleId     String
  status       ModuleAccessStatus @default(LOCKED)
  progress     Int                @default(0)
  // True only when a curator explicitly set access for this one student (open or close),
  // as opposed to inheriting the module's defaultAccess. The module-wide toggle skips
  // override rows so it never silently clobbers a curator's individual decision.
  isOverride   Boolean            @default(false)
  unlockedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  enrollment   Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  module       Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, moduleId])
  @@index([moduleId, status])
}

model MediaAsset {
  id          String           @id @default(cuid())
  practicumId String
  moduleId    String?
  scheduleEventId String?
  provider    String
  providerKey String
  kind        MediaAssetKind   @default(STREAM)
  status      MediaAssetStatus @default(DRAFT)
  title       String?
  description String?
  mimeType    String?
  durationSec Int?
  position    Int              @default(0)
  publishedAt DateTime?
  // Snapshot of the live-chat time window at the moment this asset was auto-created from a
  // stream recording — lets StreamChatService.getArchivedMessages find "the chat that
  // happened during this broadcast" without needing a session id on StreamMessage itself.
  // Null for anything not auto-created from a live recording (manual Vimeo uploads etc).
  chatSessionStartedAt DateTime?
  chatSessionEndedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  practicum   Practicum        @relation(fields: [practicumId], references: [id], onDelete: Cascade)
  module      Module?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  scheduleEvent ScheduleEvent? @relation(fields: [scheduleEventId], references: [id], onDelete: SetNull)
  feedback    Feedback[]
  playbackEvents MediaPlaybackEvent[]

  @@unique([provider, providerKey, moduleId])
  @@index([moduleId, status, position])
  @@index([scheduleEventId, status, position])
  @@index([practicumId, status, position])
}

/**
 * One row per time a viewer actually opens a video (not per API fetch) — the
 * audit trail behind the on-screen watermark. If a recording leaks, cross-referencing
 * who opened that exact media around the leaked timestamp narrows down the source.
 */
/** Backs the in-app notification bell — real per-user events, not the static demo list it replaced. */
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  entityId  String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

model MediaPlaybackEvent {
  id           String     @id @default(cuid())
  mediaAssetId String
  userId       String
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime   @default(now())
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mediaAssetId, createdAt])
  @@index([userId, createdAt])
}

model ScheduleEvent {
  id          String            @id @default(cuid())
  practicumId String
  type        ScheduleEventType
  title       String
  date        DateTime          @db.Date
  time        String
  description String
  live        Boolean           @default(false)
  coverPath   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  practicum   Practicum         @relation(fields: [practicumId], references: [id], onDelete: Cascade)
  mediaAssets MediaAsset[]
  // Individual BACKTEST/PRE_SESSION slots: one event = one bookable time, claimed by at
  // most one student. ScheduleService.book() enforces a per-student, per-type limit read
  // from Practicum.backtestSlotLimit/preSessionSlotLimit (default 1) — a count against the
  // configured limit, not a hardcoded one-time check.
  bookedByStudentId String?
  bookedAt          DateTime?
  bookedBy          User?             @relation("ScheduleEventBooking", fields: [bookedByStudentId], references: [id], onDelete: SetNull)

  @@index([practicumId, date])
  @@index([practicumId, type, date])
  @@index([bookedByStudentId])
}

/** Append-only log of book/cancel actions — ScheduleEvent.bookedByStudentId only holds the
  * CURRENT booking (nulled out on cancel), so this is the only place booking history lives.
  * Stores a snapshot of the event's title/date/time so history stays readable even if the
  * original event is later edited or deleted; eventId is a plain reference, not an FK. */
model ScheduleBooking {
  id          String                @id @default(cuid())
  practicumId String
  eventId     String
  eventType   ScheduleEventType
  eventTitle  String
  eventDate   DateTime              @db.Date
  eventTime   String
  studentId   String
  action      ScheduleBookingAction
  actorId     String
  createdAt   DateTime              @default(now())
  practicum   Practicum             @relation(fields: [practicumId], references: [id], onDelete: Cascade)
  student     User                  @relation("ScheduleBookingStudent", fields: [studentId], references: [id], onDelete: Cascade)
  actor       User                  @relation("ScheduleBookingActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([practicumId, eventType, createdAt])
}

model Assignment {
  id          String           @id @default(cuid())
  moduleId    String
  title       String
  description String
  requirements Json?
  allowedFormats Json?
  status      AssignmentStatus @default(DRAFT)
  deadline    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions Submission[]
  materials   AssignmentMaterial[]
  discussionThreads DiscussionThread[]

  @@index([moduleId, status])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  attempt      Int              @default(1)
  status       SubmissionStatus @default(DRAFT)
  answerText   String?
  attachments  Json?
  submittedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  reviewerId   String?
  claimedAt    DateTime?
  // Snapshot (requirement text, not index — the assignment's own list can change later) of
  // which criteria the curator had checked off at the moment they decided. Criteria are
  // advisory, not a hard gate for acceptance — this is what lets the student/curator see
  // later that a submission was accepted even though not every box was ticked.
  checkedRequirements Json?
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer     User?            @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  fileAttachments SubmissionAttachment[]
  feedback     Feedback[]

  @@unique([assignmentId, studentId, attempt])
  @@index([studentId, status])
  @@index([assignmentId, status])
  @@index([reviewerId, status])
}

model StoredFile {
  id             String          @id @default(cuid())
  ownerId        String
  storageKey     String          @unique
  originalName   String
  mimeType       String
  byteSize       Int
  status         StoredFileStatus @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  submissions    SubmissionAttachment[]
  assignmentMaterials AssignmentMaterial[]
  discussionAttachments DiscussionAttachment[]
  feedbackAttachments FeedbackAttachment[]
  streamMessages StreamMessage[]

  @@index([ownerId, status])
}

model AssignmentMaterial {
  id           String                 @id @default(cuid())
  assignmentId String
  kind         AssignmentMaterialKind
  title        String
  url          String?
  fileId       String?
  mimeType     String?
  byteSize     Int?
  position     Int                    @default(0)
  createdAt    DateTime               @default(now())
  assignment   Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  file         StoredFile?            @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([assignmentId, position])
  @@index([fileId])
}

model SubmissionAttachment {
  id           String     @id @default(cuid())
  submissionId String
  fileId       String
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  file         StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([submissionId, fileId])
  @@index([submissionId, position])
}

model Feedback {
  id           String      @id @default(cuid())
  submissionId String
  authorId     String
  text         String
  mediaAssetId String?
  createdAt    DateTime    @default(now())
  submission   Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author       User        @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  attachments  FeedbackAttachment[]

  @@index([submissionId, createdAt])
}

model FeedbackAttachment {
  id           String     @id @default(cuid())
  feedbackId   String
  fileId       String
  originalName String
  mimeType     String
  byteSize     Int
  createdAt    DateTime   @default(now())
  feedback     Feedback   @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  file         StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([feedbackId, createdAt])
  @@index([fileId])
}

model DiscussionThread {
  id           String              @id @default(cuid())
  studentId    String
  curatorId    String?
  moduleId     String?
  assignmentId String?
  title        String
  status       DiscussionStatus    @default(NEW)
  visibility   DiscussionVisibility @default(PRIVATE)
  lastMessageAt DateTime           @default(now())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  student      User                @relation("DiscussionStudentThreads", fields: [studentId], references: [id], onDelete: Cascade)
  curator      User?               @relation("DiscussionCuratorThreads", fields: [curatorId], references: [id], onDelete: SetNull)
  module       Module?             @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  assignment   Assignment?         @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  messages     DiscussionMessage[]

  @@index([studentId, lastMessageAt])
  @@index([curatorId, status, lastMessageAt])
  @@index([assignmentId, createdAt])
}

model DiscussionMessage {
  id          String                 @id @default(cuid())
  threadId    String
  authorId    String
  body        String
  createdAt   DateTime               @default(now())
  thread      DiscussionThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author      User                   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  attachments DiscussionAttachment[]

  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
}

model DiscussionAttachment {
  id           String             @id @default(cuid())
  messageId    String
  fileId       String?
  sourceUrl    String?
  originalName String
  mimeType     String
  byteSize     Int
  createdAt    DateTime           @default(now())
  message      DiscussionMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file         StoredFile?        @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([messageId, createdAt])
  @@index([fileId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  objectType String?
  objectId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([objectType, objectId])
}
