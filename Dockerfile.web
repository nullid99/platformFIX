FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

ARG API_PROXY_TARGET=http://api:4000
ARG DATABASE_URL=postgresql://fix_app:fix_app@localhost:5432/fix_platform?schema=public
ARG NEXT_PUBLIC_DEV_AUTH_ENABLED=false
ARG NEXT_PUBLIC_LIVEKIT_URL=""
ENV API_PROXY_TARGET=${API_PROXY_TARGET}
ENV DATABASE_URL=${DATABASE_URL}
ENV NEXT_PUBLIC_DEV_AUTH_ENABLED=${NEXT_PUBLIC_DEV_AUTH_ENABLED}
ENV NEXT_PUBLIC_LIVEKIT_URL=${NEXT_PUBLIC_LIVEKIT_URL}
ENV NEXT_TELEMETRY_DISABLED=1

RUN npx prisma generate && npm run build

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# Not root (security review STG-7, 2026-10-17); next start writes its image cache under .next.
RUN chown -R node:node /app/.next
USER node

CMD ["npm", "run", "start"]
